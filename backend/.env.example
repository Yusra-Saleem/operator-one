# Copy to backend/.env and fill every value. Never commit backend/.env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Agents SDK Key & Model Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase / PostgreSQL database connection URL
DATABASE_URL=postgresql+psycopg://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# CORS browser origins
CORS_ORIGINS=http://localhost:3000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
